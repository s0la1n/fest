APP_NAME="Игровой Лабиринт"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://igrovoy-labirint.ru
FRONTEND_URL=https://igrovoy-labirint.ru

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=igrovoy_labirint
DB_USERNAME=igrovoy_user
DB_PASSWORD=change_me_strong_password

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
SESSION_LIFETIME=120
SESSION_DOMAIN=igrovoy-labirint.ru
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=igrovoy-labirint.ru,www.igrovoy-labirint.ru
CORS_ALLOWED_ORIGINS=https://igrovoy-labirint.ru,https://www.igrovoy-labirint.ru

YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
YUKASSA_TIMEOUT=30
YUKASSA_CONNECT_TIMEOUT=15

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
